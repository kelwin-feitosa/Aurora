{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "noImplicitOverride": true
  },
  "include": ["src/**/*.ts"]
}
